---
import '../styles/global.css';
import { site } from '../data/site';
import { absolute, checkPublishingConfig, isPublic, siteUrl } from '../lib/publishing';
interface Props { preview?: boolean; title?: string; description?: string; indexable?: boolean; ogImage?: string; ogImageAlt?: string }
const {title = site.name, description = site.description, indexable = true, preview = false, ogImage = site.ogImage, ogImageAlt = site.ogImageAlt} = Astro.props;
checkPublishingConfig();
const pathname = Astro.url.pathname;
const canonical = absolute(pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100c18" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={!preview && isPublic && indexable ? 'index,follow' : 'noindex,follow'} />
    {!preview && siteUrl && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!preview && siteUrl && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absolute(ogImage)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead" inert={preview}>
      <div class="wrap masthead-inner">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Main navigation">
          {site.navigation.map(item => <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'location' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-cta" href="/subscribe/">Get release notes</a>
      </div>
    </header>
    <main id="main" tabindex="-1" inert={preview}><slot /></main>
    <footer class="footer" inert={preview}>
      <div class="wrap footer-inner">
        <div><a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.name}</a><p>{site.description}</p></div>
        <a href="/privacy/">Privacy</a>
      </div>
    </footer>
  </body>
</html>
