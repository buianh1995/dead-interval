---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getArchive } from '../../lib/archive';
const {cases} = await getArchive();
---
<Base title="Cases | Dead Interval" description="Read fictional infrastructure incident dossiers and their recovered evidence.">
  <section class="wrap listing">
    <h1>Case files</h1>
    <p class="lead">Investigate open dossiers or read public excerpts from sealed records.</p>
    <div class="card-grid">{cases.map(({data}) => <CaseCard item={data} />)}</div>
  </section>
</Base>
