---
import { render } from 'astro:content';
import CaseDossier from '../../components/CaseDossier.astro';
import PublicScript from '../../components/PublicScript.astro';
import Base from '../../layouts/Base.astro';
import { getArchive, findScript } from '../../lib/archive';
export async function getStaticPaths() {
  const archive = await getArchive();
  return archive.cases.map(entry => ({params: {slug: entry.data.slug}, props: {entry, archive}}));
}
const {entry, archive} = Astro.props;
const item = entry.data;
const isSealed = item.state === 'sealed';
const Content = isSealed ? undefined : (await render(entry)).Content;
const script = item.state === 'released' && findScript(archive.scripts, item);
const Script = script ? (await render(script)).Content : undefined;
---
<Base {...item.seo}>
  <CaseDossier item={item} archive={archive}>
    {Content && <Content slot="body" />}
    {Script && script && <PublicScript slot="script" title={script.data.title}><Script /></PublicScript>}
  </CaseDossier>
</Base>
