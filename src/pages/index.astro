---
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
import CaseCard from '../components/CaseCard.astro';
import { getArchive } from '../lib/archive';
import { site } from '../data/site';
const {cases, featured, signals} = await getArchive();
const item = featured.data;
const featuredSignal = signals.find(({data}) => data.id === item.signalIds[0])!.data;
---
<Base title={site.name + ' | Interactive Cosmic Horror'}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">Interactive fiction <span></span> Cosmic horror</p>
      <h1>{site.name}<span>.</span></h1>
      <p class="hero-line">{site.headline}</p>
      <p class="muted">{site.description}</p>
      <div class="button-row hero-actions">
        <a class="button primary" href={'/cases/' + item.slug + '/'}>Read the first case</a>
        <a class="button secondary" href="/cases/">Browse the archive</a>
      </div>
    </div>
    <figure class="hero-visual">
      <div class="hero-image"><Artwork art={item.art} eager /></div>
      <figcaption><span>{item.number} / {item.title}</span><span>{item.art.kind === 'concept' ? 'Concept art' : item.art.kind === 'keyframe' ? 'Keyframe' : 'Archive illustration'}</span></figcaption>
    </figure>
  </section>
  <section class="wrap first-signal" aria-labelledby="first-signal">
    <div class="record-line"><span class="transmission-dot"></span>{featuredSignal.archiveStamp}</div>
    <div><h2 id="first-signal">{featuredSignal.title}</h2><p>{featuredSignal.summary}</p></div>
    <a class="text-action" href={'/signals/' + featuredSignal.slug + '/'}>Open signal</a>
  </section>
  <section class="wrap section" aria-labelledby="cases-title">
    <div class="section-heading"><div><h2 id="cases-title">Case files</h2><p>Read the records and decide what the system missed.</p></div><a href="/cases/">All cases</a></div>
    <div class="card-grid">{cases.map(({data}) => <CaseCard item={data} heading="h3" />)}</div>
  </section>
  <section class="wrap signup-banner">
    <div><h2>Get release notes</h2><p>{site.signupPitch}</p></div>
    <a class="button primary" href="/subscribe/">Join the waitlist</a>
  </section>
</Base>
