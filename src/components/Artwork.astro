---
import type { CollectionEntry } from 'astro:content';
interface Props { art: CollectionEntry<'cases'>['data']['art']; eager?: boolean }
const {art, eager = false} = Astro.props;
const variants = art.kind === 'placeholder' ? undefined : art.image.variants;
---
{art.kind === 'placeholder' ? (
  <div class:list={['artwork', 'motif-' + art.motif]} aria-hidden="true"><span></span></div>
) : (
  <img class="artwork" src={art.image.src} alt={art.image.alt}
    srcset={variants?.map(variant => variant.src + ' ' + variant.width + 'w').join(', ')}
    sizes={variants?.length ? '(max-width: 720px) 100vw, 55vw' : undefined}
    style={art.image.focus && { 'object-position': (art.image.focus.x * 100) + '% ' + (art.image.focus.y * 100) + '%' }}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
)}
